---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG, url } from '../config';
---

<BaseLayout>

  <!-- ─── Hero ─────────────────────────────────────────── -->
  <section class="hero section container">
    <div class="hero__top stagger">
      <p class="label hero__eyebrow">Portfolio — {new Date().getFullYear()}</p>

      <h1 class="hero__title">
        Ambiguity<br/>
        <em>as a Resource</em><br/>
        for Design
      </h1>

      <div class="hero__desc-col">
        <p class="hero__desc">
          <br/>
          My world exists at the intersection of rigid logic and fluid motion.
        </p>
        <div class="hero__skills label">
          <span>Software Architecture</span>
          <span class="hero__dot" aria-hidden="true">◆</span>
          <span>Graphic Design</span>
          <span class="hero__dot" aria-hidden="true">◆</span>
          <span>Figure Skating</span>
        </div>
      </div>

    </div>

    <div class="hero__scroll label" aria-hidden="true">
      Scroll to explore ↓
    </div>
  </section>

  <!-- ─── About Strip ──────────────────────────────────── -->
  <section class="about-strip container" id="about-preview">
    <div class="about-strip__inner">
      <div class="about-strip__text">
        <p class="label about-strip__eyebrow">About</p>
        <p class="about-strip__body">
          Hi, my name is vanillaSky00, a software designer from Taipei
          currently studying at National Cheng Kung University.
          By day, I engineer AI agents and tackle cybersecurity.
          By design, I craft intuitive apps and artistic graphics.
        </p>
        <a href={url('/about')} class="about-strip__cta label">
          Read more →
        </a>
      </div>
      <div class="about-strip__portrait">
        {SITE_CONFIG.PORTRAIT ? (
          <img src={url(SITE_CONFIG.PORTRAIT)} alt={SITE_CONFIG.TITLE} class="about-strip__portrait-img" />
        ) : (
          <div class="img-placeholder about-strip__portrait-placeholder"><span>Portrait</span></div>
        )}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── Hero ──────────────────────────────────────────────── */
.hero {
  padding-top: calc(4rem + var(--section-gap));
  display: flex;
  flex-direction: column;
  gap: 3rem;
}

.hero__top {
  display: grid;
  grid-template-columns: auto 1fr 1fr;
  gap: 3rem;
  align-items: start;
}

.hero__eyebrow {
  color: var(--ink-faint);
  writing-mode: vertical-rl;
  text-orientation: mixed;
  transform: rotate(180deg);
  align-self: stretch;
  padding-top: 0.5rem;
}

.hero__title {
  font-size: clamp(3rem, 6vw + 1rem, 7rem);
  letter-spacing: -0.04em;
  line-height: 1.0;
  font-weight: 400;
}

.hero__title em {
  font-style: italic;
  color: var(--accent);
}

.hero__desc-col {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 1.5rem;
  padding-bottom: 0.5rem;
}

.hero__desc {
  color: var(--ink-muted);
  font-size: 1rem;
  line-height: 1.6;
  max-width: 38ch;
}

.hero__skills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
  color: var(--ink-faint);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
}

.hero__dot { color: var(--accent); font-size: 0.4rem; }

.hero__scroll {
  color: var(--ink-faint);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  animation: fadeUp 1s 0.8s var(--ease) both;
}

/* ─── About Strip ───────────────────────────────────────── */
.about-strip {
  padding-block: var(--section-gap);
}

.about-strip__inner {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 4rem;
  align-items: center;
  border: 1px solid var(--border);
  padding: 3rem;
}

.about-strip__eyebrow {
  color: var(--ink-faint);
  margin-bottom: 1rem;
}

.about-strip__body {
  font-size: clamp(1rem, 1.5vw, 1.25rem);
  line-height: 1.65;
  color: var(--ink-muted);
  max-width: 48ch;
  margin-bottom: 1.5rem;
}

.about-strip__cta {
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  color: var(--accent);
  transition: opacity 0.2s;
}
.about-strip__cta:hover { opacity: 0.6; }

.about-strip__portrait {
  aspect-ratio: 3/4;
  width: 100%;
  overflow: hidden;
}

.about-strip__portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.about-strip__portrait-placeholder {
  width: 100%;
  height: 100%;
}

@media (max-width: 900px) {
  .hero__top {
    grid-template-columns: 1fr;
  }
  .hero__eyebrow {
    writing-mode: horizontal-tb;
    transform: none;
  }
  .about-strip__inner {
    grid-template-columns: 1fr;
  }
  .about-strip__portrait {
    aspect-ratio: 16/9;
  }
}
</style>
