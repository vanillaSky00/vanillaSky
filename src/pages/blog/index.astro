---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../config';
import {
  formatReadingTime,
  formatShortDate,
  getPostUpdatedDate,
  getReadingMinutes,
} from '../../lib/blogMeta';

const allPosts = await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing" description="Essays and notes by vanillaSky00.">

  <div class="blog-index section container">

    <header class="blog-header stagger">
      <p class="label blog-header__eyebrow">Writing</p>
      <h1 class="blog-header__title"></h1>
    </header>

    <div class="blog-list">
      {posts.map((post, i) => (
        <a
          href={url(`/blog/${post.slug}`)}
          class="blog-row"
          style={`animation-delay: ${i * 0.06}s`}
        >
          <span class="blog-row__meta label">
            <span>Updated {formatShortDate(getPostUpdatedDate(post))}</span>
            <span>{formatReadingTime(getReadingMinutes(post.body))}</span>
          </span>
          <span class="blog-row__title">{post.data.title}</span>
          <div class="blog-row__tags">
            {post.data.tags.map(tag => (
              <span class="blog-row__tag label">{tag}</span>
            ))}
          </div>
          <span class="blog-row__arrow label">→</span>
        </a>
      ))}

      {posts.length === 0 && (
        <p class="blog-empty label">No posts yet.</p>
      )}
    </div>

  </div>

</BaseLayout>

<style>
.blog-index {
  padding-top: calc(4rem + var(--section-gap));
}

.blog-header {
  margin-bottom: 4rem;
}

.blog-header__eyebrow {
  color: var(--ink-faint);
  margin-bottom: 1rem;
}

.blog-header__title {
  font-size: clamp(3rem, 6vw, 7rem);
  letter-spacing: -0.04em;
  line-height: 1.0;
}

.blog-list {
  display: flex;
  flex-direction: column;
}

.blog-row {
  display: grid;
  grid-template-columns: 160px minmax(0, 1fr) auto auto;
  gap: 2rem;
  align-items: baseline;
  padding-block: 1.5rem;
  border-bottom: 1px solid var(--border);
  transition: opacity 0.2s;
  animation: fadeUp 0.6s var(--ease) both;
}
.blog-row:hover { opacity: 0.6; }

.blog-row__meta {
  color: var(--ink-faint);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-size: 0.65rem;
  line-height: 1.35;
}

.blog-row__title {
  font-family: var(--font-brand);
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0;
  color: var(--ink);
}

.blog-row__tags {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.blog-row__tag {
  font-size: 0.6rem;
  color: var(--ink-faint);
  border: 1px solid var(--border-strong);
  padding: 0.1rem 0.4rem;
  border-radius: 2px;
}

.blog-row__arrow {
  color: var(--accent);
  font-size: 0.8rem;
}

.blog-empty {
  color: var(--ink-faint);
  padding-block: 3rem;
}

@media (max-width: 800px) {
  .blog-row {
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }
  .blog-row__arrow { display: none; }
}
</style>
