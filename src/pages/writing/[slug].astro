---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialDetail from '../../components/EditorialDetail.astro';
import { getCollection } from 'astro:content';
import { formatLongDate, getPostUpdatedDate } from '../../lib/writingMeta';
import { rankRelated, toProjectSummary, toWritingSummary } from '../../lib/content.js';

export async function getStaticPaths() {
  const writing = await getCollection('writing', ({ data }) => !data.draft || import.meta.env.DEV);
  return writing.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const writing = await getCollection('writing', ({ data }) => !data.draft || import.meta.env.DEV);
const projects = await getCollection('projects');
const current = toWritingSummary(post);
const related = rankRelated(current, [
  ...projects.map(toProjectSummary),
  ...writing.map(toWritingSummary),
]);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <EditorialDetail
    backHref="/writing"
    backLabel="Writing"
    title={post.data.title}
    description={post.data.description}
    tags={post.data.tags}
    meta={`Writing · ${formatLongDate(getPostUpdatedDate(post))}`}
    heroImage={post.data.heroVideo ? undefined : post.data.coverImage}
    heroVideo={post.data.heroVideo}
    related={related}
  >
    <Content />
  </EditorialDetail>
</BaseLayout>
