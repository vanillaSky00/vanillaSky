---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="Work" description="Selected projects by vanillaSky00.">

  <div class="work-index section container">
    <header class="work-header stagger">
      <p class="label work-header__eyebrow">Work</p>
      <h1 class="work-header__title">Selected Projects</h1>
    </header>

    <section class="work-list" aria-label="Projects">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </section>
  </div>

</BaseLayout>

<style>
.work-index {
  padding-top: calc(4rem + var(--section-gap));
}

.work-header {
  margin-bottom: 4rem;
}

.work-header__eyebrow {
  color: var(--ink-faint);
  margin-bottom: 1rem;
}

.work-header__title {
  font-size: clamp(3rem, 6vw, 7rem);
  letter-spacing: -0.04em;
  line-height: 1.0;
}

.work-list {
  display: flex;
  flex-direction: column;
}
</style>
