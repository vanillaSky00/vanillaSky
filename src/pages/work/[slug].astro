---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialDetail from '../../components/EditorialDetail.astro';
import { getCollection } from 'astro:content';
import { rankRelated, toProjectSummary, toWritingSummary } from '../../lib/content.js';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft || import.meta.env.DEV);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const writing = await getCollection('writing', ({ data }) => !data.draft || import.meta.env.DEV);
const projects = await getCollection('projects', ({ data }) => !data.draft || import.meta.env.DEV);
const current = toProjectSummary(project);
const related = rankRelated(current, [
  ...projects.map(toProjectSummary),
  ...writing.map(toWritingSummary),
]);
const links: { label: string; href: string }[] = [];

if (project.data.link) links.push({ label: 'Live Project', href: project.data.link });
if (project.data.github) links.push({ label: 'GitHub', href: project.data.github });
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <EditorialDetail
    backHref="/work"
    backLabel="Work"
    title={project.data.title}
    subtitle={project.data.subtitle}
    description={project.data.description}
    tags={project.data.tags}
    meta={`${project.data.category} · ${project.data.year}`}
    heroImage={project.data.heroVideo ? undefined : project.data.coverImage}
    heroVideo={project.data.heroVideo}
    links={links}
    related={related}
    titleInSummary
  >
    <Content />
  </EditorialDetail>
</BaseLayout>
